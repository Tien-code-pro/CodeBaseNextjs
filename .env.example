# App mode
# html: static export / HTML slicing mode
# web: server mode, enables server-side auth token bootstrap
NEXT_PUBLIC_MODE='html'

# General
LOG_SERVER=1
BASE_WEB='http://localhost:3000'
NEXT_PUBLIC_BASE_PATH=''

# Server-only auth/API config
# Do not expose these values with NEXT_PUBLIC_.
# AUTHEN is the preferred auth-cookie name; AU_THEN remains a supported legacy alias.
AUTHEN='vtcgame-jwt'
# AU_THEN='vtcgame-jwt'
API_OAUTH='https://oauthen-beta.example.vn'
API_BACKEND='https://apiweb-beta.example.vn'
API_PLUS='https://apivtcplus.example.vn'
KEY_SECURE_IMAGE='replace-with-16-byte-secure-image-key'
API_SECRET='replace-with-api-secret'
key='AU'
MAKER_CODE='replace-with-maker-code'
HEADER_AUTHEN='https://example.vn/headerbeta/headerJS/headjs.js'
BODY_AUTHEN='https://example.vn/headerbeta/headerJS/BodyCall.js'

# Public client config
# NEXT_PUBLIC_* values are bundled into browser/client code.
NEXT_PUBLIC_API_BACKEND='https://apiweb-beta.example.vn'
NEXT_PUBLIC_API_PLUS='https://apivtcplus.example.vn'
NEXT_PUBLIC_API_SECURE_IMAGE='https://apiweb-beta.example.vn/secureimage'
NEXT_PUBLIC_API_SECRET='replace-only-if-this-is-intentionally-public'
NEXT_PUBLIC_AUTH_COOKIE='vtcgame-jwt'
NEXT_PUBLIC_MAKER_CODE='replace-with-public-maker-code'

# Media
# 0: local public assets, 1: CDN assets
NEXT_PUBLIC_BASE_MEDIA='https://cdnmedia.example.vn/project/path'
